# Allow .gitkeep and small REW exports (text only)
!data/raw/.gitkeep
!data/ir/.gitkeep
!data/results/.gitkeep
!data/reference/.gitkeep
!data/reference/*.txt

# Jupyter
.ipynb_checkpoints/
*.ipynb

